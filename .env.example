# Пример конфигурации. Скопируйте в .env и задайте значения.
# Файл .env не публикуется и не попадает в клиентский код.

# Адрес и порт сервера приложения. За nginx оставьте 127.0.0.1.
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

# Каталог данных: база SQLite, загруженные файлы, вложения, резервные копии.
# Относительный путь считается от корня проекта.
DATA_DIR=data

# true — только при работе через HTTPS (обязательно на сервере в сети).
COOKIE_SECURE=false
# true — если перед приложением стоит nginx / обратный прокси.
TRUST_PROXY=false
# Дополнительные разрешённые источники запросов (через запятую), обычно не нужны.
ALLOWED_ORIGINS=

# Время жизни сессии, часов.
SESSION_TTL_HOURS=12

# Ограничения размера загружаемых файлов, МБ.
MAX_IMPORT_MB=25
MAX_ATTACHMENT_MB=20

# Плановое резервное копирование БД: интервал (часы, 0 — выключить) и число хранимых копий.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=30

# Пароль первого администратора можно передать скрипту create-admin через переменную окружения
# ADMIN_PASSWORD (только на время запуска команды; не храните его в этом файле).

# Первый администратор на хостинге без консоли (Railway и т.п.): создаётся при запуске,
# только если в базе ещё нет пользователей; при первом входе пароль нужно сменить.
# Задавайте эти значения в настройках хостинга (Variables), а не в этом файле.
ADMIN_LOGIN=
ADMIN_PASSWORD=
ADMIN_NAME=
