{
  "name": "zhkh-atyrau-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "create-admin": "node scripts/create-admin.ts",
    "import-initial": "node scripts/import-initial.ts",
    "backup": "node scripts/backup.ts",
    "report": "node scripts/report.ts",
    "test": "node --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
